-- ============================================
function LoadScriptsToUI(filter, category)
    filter = filter or ""
    filter = string.lower(filter)
    category = category or "All"
    
    for _, child in pairs(ListFrame:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end
    
    local count = 0
    local loadedCount = 0
    local yPos = 0
    local cardHeight = 44
    
    for _, script in ipairs(ScriptRegistry) do
        if script.enabled then loadedCount = loadedCount + 1 end
        
        local matchName = string.find(string.lower(script.name), filter)
        local matchDesc = string.find(string.lower(script.description), filter)
        local matchCat = (category == "All" or script.category == category)
        
        if (filter == "" or matchName or matchDesc) and matchCat then
            count = count + 1
            
            local card = Instance.new("Frame")
            card.Size = UDim2.new(1, 0, 0, cardHeight)
            card.Position = UDim2.new(0, 0, 0, yPos)
            card.BackgroundColor3 = script.enabled and Color3.fromRGB(0, 60, 30) or Settings.Theme.CardBg
            card.BackgroundTransparency = 0.1
            card.BorderSizePixel = 1
            card.BorderColor3 = script.enabled and Color3.fromRGB(0, 255, 100) or Settings.Theme.Border
            card.ClipsDescendants = true
            card.Parent = ListFrame
            
            local cardCorner = Instance.new("UICorner")
            cardCorner.CornerRadius = UDim.new(0, 6)
            cardCorner.Parent = card
            
            -- Glow on hover
            local cardGlow = Instance.new("Frame")
            cardGlow.Size = UDim2.new(1, 0, 1, 0)
            cardGlow.BackgroundColor3 = Settings.Theme.Primary
            cardGlow.BackgroundTransparency = 0.9
            cardGlow.BorderSizePixel = 0
            cardGlow.Visible = false
            cardGlow.Parent = card
            
            local glowCorner = Instance.new("UICorner")
            glowCorner.CornerRadius = UDim.new(0, 6)
            glowCorner.Parent = cardGlow
            
            -- Icon
            local icon = Instance.new("TextLabel")
            icon.Size = UDim2.new(0, 26, 1, 0)
            icon.BackgroundTransparency = 1
            icon.Text = script.icon or "📦"
            icon.TextColor3 = Color3.fromRGB(255, 255, 255)
            icon.TextSize = 14
            icon.Parent = card
            
            -- Name
            local nameLabel = Instance.new("TextLabel")
            nameLabel.Size = UDim2.new(0.35, -30, 0, 14)
            nameLabel.Position = UDim2.new(0, 30, 0, 3)
            nameLabel.BackgroundTransparency = 1
            nameLabel.Text = script.name
            nameLabel.TextColor3 = Settings.Theme.Text
            nameLabel.TextSize = 10
            nameLabel.Font = Enum.Font.GothamBold
            nameLabel.TextXAlignment = Enum.TextXAlignment.Left
            nameLabel.Parent = card
            
            -- Category Badge
            local catBadge = Instance.new("Frame")
            catBadge.Size = UDim2.new(0, 50, 0, 12)
            catBadge.Position = UDim2.new(0.35, 5, 0, 3)
            catBadge.BackgroundColor3 = script.color
            catBadge.BackgroundTransparency = 0.3
            catBadge.BorderSizePixel = 0
            catBadge.Parent = card
            
            local catCorner = Instance.new("UICorner")
            catCorner.CornerRadius = UDim.new(0, 3)
            catCorner.Parent = catBadge
            
            local catText = Instance.new("TextLabel")
            catText.Size = UDim2.new(1, 0, 1, 0)
            catText.BackgroundTransparency = 1
            catText.Text = script.category or ""
            catText.TextColor3 = Color3.fromRGB(255, 255, 255)
            catText.TextSize = 7
            catText.Font = Enum.Font.GothamBold
            catText.Parent = catBadge
            
            -- Note
            if script.note then
                local noteLabel = Instance.new("TextLabel")
                noteLabel.Size = UDim2.new(0.25, -5, 0, 11)
                noteLabel.Position = UDim2.new(0.35, 60, 0, 18)
                noteLabel.BackgroundTransparency = 1
                noteLabel.Text = script.note
                noteLabel.TextColor3 = Settings.Theme.Accent
                noteLabel.TextSize = 7
                noteLabel.Font = Enum.Font.GothamBold
                noteLabel.TextXAlignment = Enum.TextXAlignment.Left
                noteLabel.Parent = card
            end
            
            -- Description
            local descLabel = Instance.new("TextLabel")
            descLabel.Size = UDim2.new(0.5, -45, 0, 11)
            descLabel.Position = UDim2.new(0, 30, 0, 20)
            descLabel.BackgroundTransparency = 1
            descLabel.Text = script.description or ""
            descLabel.TextColor3 = Settings.Theme.SubText
            descLabel.TextSize = 8
            descLabel.Font = Enum.Font.Gotham
            descLabel.TextXAlignment = Enum.TextXAlignment.Left
            descLabel.TextTruncate = Enum.TextTruncate.AtEnd
            descLabel.Parent = card
            
            -- Status indicator
            local statusDot = Instance.new("Frame")
            statusDot.Size = UDim2.new(0, 6, 0, 6)
            statusDot.Position = UDim2.new(1, -10, 0.5, -3)
            statusDot.BackgroundColor3 = script.enabled and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(100, 100, 100)
            statusDot.BorderSizePixel = 0
            statusDot.Parent = card
            
            local dotCorner = Instance.new("UICorner")
            dotCorner.CornerRadius = UDim.new(1, 0)
            dotCorner.Parent = statusDot
            
            -- Load Button
            local loadBtn = Instance.new("TextButton")
            loadBtn.Size = UDim2.new(0, 55, 0, 24)
            loadBtn.Position = UDim2.new(1, -70, 0.5, -12)
            loadBtn.BackgroundColor3 = script.enabled and Color3.fromRGB(0, 200, 100) or Settings.Theme.Primary
            loadBtn.BackgroundTransparency = 0.1
            loadBtn.Text = script.enabled and "✓" or "Load"
            loadBtn.TextColor3 = Settings.Theme.Text
            loadBtn.TextSize = 9
            loadBtn.Font = Enum.Font.GothamBold
            loadBtn.Parent = card
            
            local btnCorner = Instance.new("UICorner")
            btnCorner.CornerRadius = UDim.new(0, 4)
            btnCorner.Parent = loadBtn
            
            -- Hover effects
            card.MouseEnter:Connect(function()
                Tween(card, { BackgroundTransparency = 0.05 }, 0.15)
                cardGlow.Visible = true
                Tween(cardGlow, { BackgroundTransparency = 0.85 }, 0.15)
            end)
            card.MouseLeave:Connect(function()
                Tween(card, { BackgroundTransparency = 0.1 }, 0.15)
                Tween(cardGlow, { BackgroundTransparency = 0.9 }, 0.15)
                task.wait(0.15)
                cardGlow.Visible = false
            end)
            
            loadBtn.MouseEnter:Connect(function()
                Tween(loadBtn, { BackgroundTransparency = 0.3 }, 0.1)
            end)
            loadBtn.MouseLeave:Connect(function()
                Tween(loadBtn, { BackgroundTransparency = 0.1 }, 0.1)
            end)
            
            -- Click handler
            loadBtn.MouseButton1Click:Connect(function()
                if script.enabled then
                    StatusLabel.Text = "⚠️ " .. script.name .. " loaded"
                    return
                end
                
                StatusLabel.Text = "⏳ Loading " .. script.name .. "..."
                loadBtn.Text = "..."
                loadBtn.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
                StatusIcon.TextColor3 = Color3.fromRGB(255, 200, 0)
                
                task.spawn(function()
                    local success = false
                    
                    if script.customLoad then
                        success = script.customLoad()
                    else
                        local scriptData = FetchScript(script.url)
                        if scriptData then
                            success = ExecuteScript(scriptData, script.name)
                        end
                    end
                    
                    if success then
                        script.enabled = true
                        loadBtn.Text = "✓"
                        loadBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
                        card.BorderColor3 = Color3.fromRGB(0, 255, 100)
                        statusDot.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
                        card.BackgroundColor3 = Color3.fromRGB(0, 60, 30)
                        StatusLabel.Text = "✅ " .. script.name .. " loaded!"
                        StatusIcon.TextColor3 = Color3.fromRGB(0, 255, 100)
                        
                        local total = 0
                        for _, s in pairs(ScriptRegistry) do
                            if s.enabled then total = total + 1 end
                        end
                        CounterLabel.Text = "⚡ " .. total .. "/" .. #ScriptRegistry
                        ProgFill.Size = UDim2.new(total/#ScriptRegistry, 0, 1, 0)
                    else
                        loadBtn.Text = "✕"
                        loadBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
                        StatusLabel.Text = "❌ Failed " .. script.name
                        StatusIcon.TextColor3 = Color3.fromRGB(255, 50, 50)
                    end
                end)
            end)
            
            yPos = yPos + cardHeight + 4
        end
    end
    
    ListFrame.CanvasSize = UDim2.new(0, 0, 0, yPos + 10)
    CounterLabel.Text = "⚡ " .. loadedCount .. "/" .. #ScriptRegistry
    ProgFill.Size = UDim2.new(loadedCount/#ScriptRegistry, 0, 1, 0)
    
    if loadedCount > #ScriptRegistry * 0.7 then
        ProgFill.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
    elseif loadedCount > #ScriptRegistry * 0.3 then
        ProgFill.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
    else
        ProgFill.BackgroundColor3 = Color3.fromRGB(255, 100, 100)
    end
end

-- ============================================
-- LOADING SEQUENCE
-- ============================================
local function LoadingSequence()
    local steps = {
        {text = "Initializing...", progress = 0.1},
        {text = "Loading Script Registry...", progress = 0.25},
        {text = "Fetching Scripts...", progress = 0.4},
        {text = "Building UI...", progress = 0.6},
        {text = "Loading Scripts...", progress = 0.75},
        {text = "Finalizing...", progress = 0.9},
        {text = "Ready!", progress = 1.0}
    }
    
    for _, step in ipairs(steps) do
        LoadStatus.Text = step.text
        LoadProgFill.Size = UDim2.new(step.progress, 0, 1, 0)
        if step.progress > 0.7 then
            LoadProgFill.BackgroundColor3 = Color3.fromRGB(0, 255, 100)
        elseif step.progress > 0.4 then
            LoadProgFill.BackgroundColor3 = Color3.fromRGB(255, 200, 0)
        else
            LoadProgFill.BackgroundColor3 = Color3.fromRGB(255, 100, 0)
        end
        task.wait(0.3)
    end
    
    -- Show Toggle Button
    ToggleBtn.Visible = true
    Tween(ToggleBtn, { BackgroundTransparency = 0.05 }, 0.3)
    
    -- Hide Loading Screen
    Tween(LoadingFrame, { BackgroundTransparency = 1 }, 0.5)
    task.wait(0.5)
    LoadingFrame.Visible = false
    LoadingFrame.Parent = nil
    
    -- Show Main Frame
    MainFrame.Visible = true
    UpdateUISize()
    Tween(MainFrame, { Size = UDim2.new(0, Settings.Size.Width * Settings.Size.Scale, 0, Settings.Size.Height * Settings.Size.Scale) }, 0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    
    print("✅ HIeuDzXD MANAGER v5.2 LOADED!")
    print("📊 Total Scripts: " .. #ScriptRegistry)
end

