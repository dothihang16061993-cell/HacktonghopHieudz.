local FOVCircle = Drawing.new("Circle")
FOVCircle.Thickness = 2 FOVCircle.NumSides = 60 FOVCircle.Radius = Settings.Combat.FovSize FOVCircle.Filled = false FOVCircle.Color = Color3.fromRGB(192, 38, 211) FOVCircle.Visible = false

local function GetClosestPlayer()
    local target = nil
    local shortestDist = Settings.Combat.FovSize
    local mousePos = UserInputService:GetMouseLocation()

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            if not Settings.Combat.TeamCheck or player.Team ~= LocalPlayer.Team then
                local humanoid = player.Character:FindFirstChild("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    local part = player.Character:FindFirstChild(Settings.Combat.AimPart)
                    if part then
                        local screenPos, onScreen = Camera:WorldToViewportPoint(part.Position)
                        if onScreen then
                            local dist = (Vector2.new(screenPos.X, screenPos.Y) - mousePos).Magnitude
                            if dist < shortestDist then
                                shortestDist = dist
                                target = player
                            end
                        end
                    end
                end
            end
        end
    end
    return target
end

RunService.RenderStepped:Connect(function()
    local mousePos = UserInputService:GetMouseLocation()
    FOVCircle.Position = mousePos
    FOVCircle.Visible = Settings.Combat.FovVisible and Settings.Combat.AimbotEnabled

    if Settings.Combat.AimbotEnabled and UserInputService:IsMouseButtonPressed(Settings.Combat.AimbotKey) then
        local target = GetClosestPlayer()
        if target and target.Character and target.Character:FindFirstChild(Settings.Combat.AimPart) then
            local partPos = target.Character[Settings.Combat.AimPart].Position
            Camera.CFrame = CFrame.new(Camera.CFrame.Position, partPos)
        end
    end

    if Settings.Combat.HitboxExtender then
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                p.Character.HumanoidRootPart.Size = Vector3.new(Settings.Combat.HitboxSize, Settings.Combat.HitboxSize, Settings.Combat.HitboxSize)
                p.Character.HumanoidRootPart.Transparency = 0.7
                p.Character.HumanoidRootPart.CanCollide = false
            end
        end
    end

    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        if Settings.Combat.WalkSpeedEnabled then
            LocalPlayer.Character.Humanoid.WalkSpeed = Settings.Combat.WalkSpeedValue
        end
    end

    if Settings.Combat.NoclipEnabled and LocalPlayer.Character then
        for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end

    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if not ESPStorage[player] then
                ESPStorage[player] = CreateDrawingObjects()
            end
            
            local drawings = ESPStorage[player]
            local char = player.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            local hum = char and char:FindFirstChild("Humanoid")
            
            local shouldShow = char and hrp and hum and hum.Health > 0 and (not Settings.Combat.TeamCheck or player.Team ~= LocalPlayer.Team)
            
            if shouldShow then
                local vector, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                if onScreen then
                    local head = char:FindFirstChild("Head")
                    local headPos = head and head.Position + Vector3.new(0, 0.5, 0) or hrp.Position + Vector3.new(0, 3, 0)
                    local legPos = hrp.Position - Vector3.new(0, 3, 0)
                    
                    local headV, _ = Camera:WorldToViewportPoint(headPos)
                    local legV, _ = Camera:WorldToViewportPoint(legPos)
                    
                    local height = math.abs(headV.Y - legV.Y)
                    local width = height / 2
                    local boxPos = Vector2.new(vector.X - width / 2, headV.Y)
                    local boxSize = Vector2.new(width, height)
                    
                    if Settings.Combat.BoxESP then
                        drawings.BoxOutline.Visible = true drawings.BoxOutline.Position = boxPos drawings.BoxOutline.Size = boxSize
                        drawings.Box.Visible = true drawings.Box.Position = boxPos drawings.Box.Size = boxSize
                    else
                        drawings.Box.Visible = false drawings.BoxOutline.Visible = false
                    end
                    
                    if Settings.Combat.NameESP then
                        drawings.Name.Visible = true
                        drawings.Name.Text = player.Name .. " [" .. math.floor((Camera.CFrame.Position - hrp.Position).Magnitude) .. "m]"
                        drawings.Name.Position = Vector2.new(vector.X, headV.Y - 18)
                    else
                        drawings.Name.Visible = false
                    end
                    
                    if Settings.Combat.HealthESP then
                        local healthPercent = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                        local barHeight = height * healthPercent
                        drawings.HealthBarOutline.Visible = true
                        drawings.HealthBarOutline.From = Vector2.new(boxPos.X - 6, boxPos.Y + height)
                        drawings.HealthBarOutline.To = Vector2.new(boxPos.X - 6, boxPos.Y)
                        drawings.HealthBar.Visible = true
                        drawings.HealthBar.From = Vector2.new(boxPos.X - 6, boxPos.Y + height)
                        drawings.HealthBar.To = Vector2.new(boxPos.X - 6, boxPos.Y + (height - barHeight))
                        drawings.HealthBar.Color = Color3.fromRGB(255 * (1 - healthPercent), 255 * healthPercent, 0)
                    else
                        drawings.HealthBar.Visible = false drawings.HealthBarOutline.Visible = false
                    end
                    
                    if Settings.Combat.TracerESP then
                        drawings.Tracer.Visible = true
                        drawings.Tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                        drawings.Tracer.To = Vector2.new(vector.X, legV.Y)
                    else
                        drawings.Tracer.Visible = false
                    end
                else
                    drawings.Box.Visible = false drawings.BoxOutline.Visible = false drawings.Name.Visible = false
                    drawings.HealthBar.Visible = false drawings.HealthBarOutline.Visible = false drawings.Tracer.Visible = false
                end
            else
                if drawings then
                    drawings.Box.Visible = false drawings.BoxOutline.Visible = false drawings.Name.Visible = false
                    drawings.HealthBar.Visible = false drawings.HealthBarOutline.Visible = false drawings.Tracer.Visible = false
                end
            end
        end
    end
end)

