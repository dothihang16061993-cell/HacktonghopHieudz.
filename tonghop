local currentTab = "About"
local isSwitchesAnimating = false

local function SwitchTab(newTabName)
    if currentTab == newTabName or isSwitchesAnimating then return end
    isSwitchesAnimating = true
    
    local oldPage = Pages[currentTab]
    local newPage = Pages[newTabName]
    
    for tName, btn in pairs(TabButtons) do
        if tName == newTabName then
            TweenService:Create(btn, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                BackgroundColor3 = Settings.Theme.Primary,
                BackgroundTransparency = 0.1
            }):Play()
        else
            TweenService:Create(btn, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                BackgroundColor3 = Settings.Theme.CardBg,
                BackgroundTransparency = 0.6
            }):Play()
        end
    end
    
    newPage.Visible = true
    newPage.Position = UDim2.new(1, 0, 0, 0)
    
    local tweenInfo = TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)
    local t1 = TweenService:Create(oldPage, tweenInfo, {Position = UDim2.new(-1, 0, 0, 0)})
    local t2 = TweenService:Create(newPage, tweenInfo, {Position = UDim2.new(0, 0, 0, 0)})
    
    t1:Play()
    t2:Play()
    
    t2.Completed:Connect(function()
        oldPage.Visible = false
        oldPage.Position = UDim2.new(1, 0, 0, 0)
        currentTab = newTabName
        isSwitchesAnimating = false
    end)
end

