local function ShowToast(title, message, statusType)
    task.spawn(function()
        local color = Settings.Theme.Success
        if statusType == "error" then color = Settings.Theme.Error
        elseif statusType == "warning" then color = Settings.Theme.Warning end

        local toast = Instance.new("Frame")
        toast.Size = UDim2.new(1, 0, 0, 60)
        toast.Position = UDim2.new(1, 40, 0, 0)
        toast.BackgroundColor3 = Settings.Theme.Secondary
        toast.BackgroundTransparency = 0.05
        toast.BorderSizePixel = 0
        toast.ZIndex = 9001
        toast.Parent = ToastHolder

        local tc = Instance.new("UICorner") tc.CornerRadius = UDim.new(0, 12) tc.Parent = toast
        local stroke = Instance.new("UIStroke") stroke.Color = color stroke.Thickness = 1.5 stroke.Transparency = 0.3 stroke.Parent = toast

        local titleLbl = Instance.new("TextLabel")
        titleLbl.Size = UDim2.new(1, -20, 0, 22) titleLbl.Position = UDim2.new(0, 14, 0, 8)
        titleLbl.BackgroundTransparency = 1 titleLbl.Text = title titleLbl.TextColor3 = color
        titleLbl.TextSize = 12.5 titleLbl.Font = Enum.Font.GothamBold titleLbl.TextXAlignment = Enum.TextXAlignment.Left
        titleLbl.ZIndex = 9002 titleLbl.Parent = toast

        local msgLbl = Instance.new("TextLabel")
        msgLbl.Size = UDim2.new(1, -20, 0, 22) msgLbl.Position = UDim2.new(0, 14, 0, 30)
        msgLbl.BackgroundTransparency = 1 msgLbl.Text = message 
        msgLbl.TextColor3 = Settings.Theme.SubText msgLbl.TextSize = 10.5 msgLbl.Font = Enum.Font.Gotham
        msgLbl.TextXAlignment = Enum.TextXAlignment.Left msgLbl.ZIndex = 9002 msgLbl.Parent = toast

        TweenService:Create(toast, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)}):Play()
        task.delay(4, function()
            if toast and toast.Parent then
                TweenService:Create(toast, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {Position = UDim2.new(1, 50, 0, 0)}):Play()
                task.wait(0.3)
                toast:Destroy()
            end
        end)
    end)
end

local function FetchScript(url)
    local success, data = pcall(function() return game:HttpGet(url) end)
    if success and data then return data end
    return nil
end

local function ExecuteScript(code)
    local func, err = loadstring(code)
    if not func then return false, err end
    local success, result = pcall(func)
    if not success then return false, result end
    return true, result
end

